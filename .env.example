# Copy to .env — everything is optional. With nothing set Foz runs the demo provider.

# Server port (default 4321)
# FOZ_PORT=4321

# Force demo data on/off (default: on only when no real account is configured)
# FOZ_DEMO=1
# FOZ_DEMO_LIVE=0   # disable simulated incoming messages

# Poll interval for providers, ms (default 30000)
# FOZ_POLL_MS=30000

# Slack — user token (xoxp-…). See `pnpm foz auth slack`.
# FOZ_SLACK_TOKEN=xoxp-...
# FOZ_SLACK_LABEL=Slack · acme

# Gmail — prefer `pnpm foz auth gmail`, which writes data/gmail-credentials.json.
# FOZ_GMAIL_CLIENT_ID=
# FOZ_GMAIL_CLIENT_SECRET=
# FOZ_GMAIL_REFRESH_TOKEN=
